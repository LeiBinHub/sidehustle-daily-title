# Copy to .env and fill in. Local load is automatic (no need to `source`).
# System environment variables always override .env.

# Reddit: create a "script" app at https://www.reddit.com/prefs/apps
# Choose "script" or "web app"; client_credentials (application-only) is enough for public search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive UA: <platform>:<app id>:<version> (by /u/<your username>)
REDDIT_USER_AGENT=script:sidehustle-daily-title:0.1.0 (by /u/your_username)

# LLM (OpenAI-compatible). Default in config.json is DeepSeek.
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# V2EX API 2.0 token: https://www.v2ex.com/settings/tokens
V2EX_TOKEN=

# Optional. Public GitHub issue search works with no app and no token.
# A personal access token (no extra scopes) raises the search rate limit.
# GitHub Actions provides GITHUB_TOKEN automatically.
# GITHUB_TOKEN=

# Optional. Stack Exchange works with no app (about 300 requests/day from one IP).
# Register at https://stackapps.com/apps/oauth/register only if you want a higher quota.
# The key is enough; do not turn on OAuth.
# STACKEXCHANGE_KEY=

# Optional. Feishu custom-bot webhook URL; the daily report is pushed as a text message.
# FEISHU_WEBHOOK=

# Optional. Needed if you run locally in mainland China and Reddit/HN are blocked.
# Example: http://127.0.0.1:7890
# HTTPS_PROXY=
